# Version management for Pressor2000
# This file centralizes version information

file(READ "${CMAKE_SOURCE_DIR}/VERSION" PRESSOR2000_VERSION_STRING)
string(STRIP "${PRESSOR2000_VERSION_STRING}" PRESSOR2000_VERSION_STRING)
set(ZEROCOMP_VERSION_STRING "${PRESSOR2000_VERSION_STRING}")

string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)(-(.+))?$" VERSION_MATCH "${PRESSOR2000_VERSION_STRING}")

if(VERSION_MATCH)
    set(PRESSOR2000_VERSION_MAJOR ${CMAKE_MATCH_1})
    set(PRESSOR2000_VERSION_MINOR ${CMAKE_MATCH_2})
    set(PRESSOR2000_VERSION_PATCH ${CMAKE_MATCH_3})
    set(ZEROCOMP_VERSION_MAJOR ${CMAKE_MATCH_1})
    set(ZEROCOMP_VERSION_MINOR ${CMAKE_MATCH_2})
    set(ZEROCOMP_VERSION_PATCH ${CMAKE_MATCH_3})

    if(CMAKE_MATCH_5)
        set(PRESSOR2000_VERSION_SUFFIX ${CMAKE_MATCH_5})
        set(PRESSOR2000_VERSION_FULL "${PRESSOR2000_VERSION_MAJOR}.${PRESSOR2000_VERSION_MINOR}.${PRESSOR2000_VERSION_PATCH}-${PRESSOR2000_VERSION_SUFFIX}")
    else()
        set(PRESSOR2000_VERSION_SUFFIX "")
        set(PRESSOR2000_VERSION_FULL "${PRESSOR2000_VERSION_MAJOR}.${PRESSOR2000_VERSION_MINOR}.${PRESSOR2000_VERSION_PATCH}")
    endif()
    set(ZEROCOMP_VERSION_SUFFIX "${PRESSOR2000_VERSION_SUFFIX}")
    set(ZEROCOMP_VERSION_FULL "${PRESSOR2000_VERSION_FULL}")
else()
    message(FATAL_ERROR "Invalid version format in VERSION file: ${PRESSOR2000_VERSION_STRING}")
endif()

set(PROJECT_VERSION "${PRESSOR2000_VERSION_MAJOR}.${PRESSOR2000_VERSION_MINOR}.${PRESSOR2000_VERSION_PATCH}")
set(PROJECT_VERSION_MAJOR ${PRESSOR2000_VERSION_MAJOR})
set(PROJECT_VERSION_MINOR ${PRESSOR2000_VERSION_MINOR})
set(PROJECT_VERSION_PATCH ${PRESSOR2000_VERSION_PATCH})

if(NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
    set(PRESSOR2000_VERSION ${PRESSOR2000_VERSION_FULL} PARENT_SCOPE)
    set(ZEROCOMP_VERSION ${PRESSOR2000_VERSION_FULL} PARENT_SCOPE)
endif()

message(STATUS "Pressor2000 Version: ${PRESSOR2000_VERSION_FULL}")
message(STATUS "  Major: ${PRESSOR2000_VERSION_MAJOR}")
message(STATUS "  Minor: ${PRESSOR2000_VERSION_MINOR}")
message(STATUS "  Patch: ${PRESSOR2000_VERSION_PATCH}")
if(PRESSOR2000_VERSION_SUFFIX)
    message(STATUS "  Suffix: ${PRESSOR2000_VERSION_SUFFIX}")
endif()
